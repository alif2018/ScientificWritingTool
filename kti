        <span class="text-xs text-slate-400 hidden md:inline">Gunakan tombol panah ⬅️ ➡️ pada keyboard untuk berpindah slide</span>
        <button id="next-btn" onclick="nextSlide()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 disabled:hover:bg-indigo-600 text-white rounded-lg text-sm font-semibold transition flex items-center gap-2">
